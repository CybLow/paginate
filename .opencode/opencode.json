{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "supermemory": {
      "type": "local",
      "command": ["npx", "-y", "@supermemory/mcp-server"],
      "environment": {
        "SUPERMEMORY_API_KEY": "{env:SUPERMEMORY_API_KEY}"
      },
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      },
      "enabled": true
    },
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres"],
      "environment": {
        "DATABASE_URL": "{env:DATABASE_URL}"
      },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@anthropic/mcp-playwright"],
      "enabled": true
    },
    "docker": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-docker"],
      "enabled": true
    }
  },

  "lsp": {
    "pyright": {
      "extensions": [".py", ".pyi"],
      "initialization": {
        "python": {
          "analysis": {
            "typeCheckingMode": "strict",
            "diagnosticSeverityOverrides": {
              "reportMissingTypeStubs": "warning",
              "reportUnknownMemberType": "warning",
              "reportUnknownArgumentType": "warning"
            }
          }
        }
      }
    }
  },

  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "skill": {
      "*": "allow"
    }
  },

  "agent": {
    "build": {
      "model": "github-copilot/claude-opus-4.5",
      "temperature": 0.3,
      "prompt": "{file:.opencode/prompts/build.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow"
      }
    },
    "plan": {
      "model": "github-copilot/claude-opus-4.5",
      "temperature": 0.2,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "uv run ruff*": "allow",
          "uv run mypy*": "allow",
          "uv run pytest --collect-only*": "allow"
        },
        "webfetch": "allow"
      }
    }
  },

  "tools": {
    "context7_*": true,
    "gh_grep_*": true,
    "supermemory_*": true,
    "github_*": false,
    "postgres_*": false,
    "playwright_*": false,
    "docker_*": false
  }
}
