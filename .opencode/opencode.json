{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    },
    "supermemory": {
      "type": "remote",
      "url": "https://mcp.supermemory.ai/mcp",
      "headers": {
        "x-supermemory-api-key": "{env:SUPERMEMORY_API_KEY}"
      },
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    },
    "ast-grep": {
      "type": "local",
      "command": ["uvx", "--from", "git+https://github.com/ast-grep/ast-grep-mcp", "ast-grep-server"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/home/skusf"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      },
      "enabled": true
    },
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres", "{env:DATABASE_URL}"],
      "environment": {
        "DATABASE_URL": "{env:DATABASE_URL}"
      },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "docker": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-docker"],
      "enabled": true
    },
    "cocoindex": {
      "type": "local",
      "command": [
        "python",
        "/home/skusf/PycharmProjects/pypaginate/.opencode/scripts/cocoindex_mcp_server.py"
      ],
      "environment": {
        "DATABASE_URL": "{env:DATABASE_URL}",
        "OPENAI_API_KEY": "{env:OPENAI_API_KEY}",
        "GOOGLE_API_KEY": "{env:GOOGLE_API_KEY}",
        "COCOINDEX_EMBEDDING_PROVIDER": "{env:COCOINDEX_EMBEDDING_PROVIDER}"
      },
      "enabled": true
    }
  },

  "lsp": {
    "pyright": {
      "command": ["pyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"],
      "initialization": {
        "python": {
          "analysis": {
            "typeCheckingMode": "strict",
            "diagnosticSeverityOverrides": {
              "reportMissingTypeStubs": "warning",
              "reportUnknownMemberType": "warning",
              "reportUnknownArgumentType": "warning"
            }
          }
        }
      }
    }
  },

  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "skill": {
      "*": "allow"
    }
  },

  "agent": {
    "build": {
      "model": "github-copilot/claude-opus-4.5",
      "temperature": 0.3,
      "prompt": "{file:/home/skusf/PycharmProjects/pypaginate/.opencode/prompts/build.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow"
      }
    },
    "plan": {
      "model": "github-copilot/claude-opus-4.5",
      "temperature": 0.2,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "uv run ruff*": "allow",
          "uv run mypy*": "allow",
          "uv run pytest --collect-only*": "allow"
        },
        "webfetch": "allow"
      }
    }
  },

  "tools": {
    "context7_*": true,
    "gh_grep_*": true,
    "exa_*": true,
    "supermemory_*": true,
    "memory_*": true,
    "ast-grep_*": true,
    "filesystem_*": true,
    "github_*": true,
    "postgres_*": true,
    "playwright_*": true,
    "docker_*": true,
    "cocoindex_*": true
  }
}
